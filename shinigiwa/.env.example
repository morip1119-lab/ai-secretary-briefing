# ============================================================
# 死に際チャンネル / 環境変数サンプル
# このファイルを .env にコピーして値を埋めてください
# ============================================================

# ---- 原稿生成に使う LLM（必須） ------------------------------
# provider: anthropic | openai | mock
#   anthropic = ANTHROPIC_API_KEY が必要（推奨）
#   openai    = OPENAI_API_KEY が必要
#   mock      = APIキー不要。data/subjects.json に手で書いた構造をそのまま組み立てる
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---- レビュー用ローカルサーバ --------------------------------
REVIEW_PORT=4321

# ============================================================
# ここから下は config.json の posting.mode を "api" にする場合のみ必要。
# "manual"（既定）で運用している間は空のままで構いません。
# ============================================================

# ---- X (Twitter) API ----------------------------------------
# https://developer.x.com/ の Developer Portal で App を作成し、
# User authentication settings を "Read and write" にしてから取得する
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# 投稿を実際に飛ばすかどうかの安全弁。
# true の間は API を叩かず、投稿内容をコンソールに出すだけ
DRY_RUN=true
