# ============================================================
# 死に際チャンネル / 環境変数サンプル
# このファイルを .env にコピーして値を埋めてください
# ============================================================

# ---- X (Twitter) API ----------------------------------------
# https://developer.x.com/ の Developer Portal で App を作成し、
# User authentication settings を "Read and write" にしてから取得する
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# 投稿を実際に飛ばすかどうかの安全弁。
# true の間は API を叩かず、投稿内容をコンソールに出すだけ（推奨: 慣れるまで true）
DRY_RUN=true

# ---- 原稿生成に使う LLM --------------------------------------
# provider: mock | anthropic | openai
#   mock      = APIキー不要。data/subjects.json の構造化データからテンプレ生成
#   anthropic = ANTHROPIC_API_KEY が必要
#   openai    = OPENAI_API_KEY が必要
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---- レビュー用ローカルサーバ --------------------------------
REVIEW_PORT=4321
